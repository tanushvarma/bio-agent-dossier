# LLM provider: gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Only needed when LLM_PROVIDER=anthropic (pip install -e ".[anthropic]")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# NCBI E-utilities: a real contact email is required; an API key raises the rate limit to 10/s
NCBI_EMAIL=your_email@example.edu
NCBI_API_KEY=

# Optional bioagent settings (defaults shown)
# BIOAGENT_MAX_STEPS=6
# BIOAGENT_MAX_TOKENS_PER_RUN=60000
# BIOAGENT_CITATION_MODE=strip
# BIOAGENT_CACHE_ENABLED=true

# Only used by the reference app in legacy/ (it reads legacy/.env)
GEMINI_SYNTHESIS_MODEL=gemini-3.5-flash-lite
SEMANTIC_SCHOLAR_API_KEY=
